<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark"
    tools:context=".selection">

    <!-- Background Grid Pattern -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.05"
        android:background="@drawable/bg_grid_pattern" />

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Card Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="#80000000"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <!-- Header with Back Button and Username -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Back Button -->
                        <ImageButton
                            android:id="@+id/btnBack"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_button_ghost"
                            android:contentDescription="Back"
                            android:padding="8dp"
                            android:src="@drawable/ic_arrow_left"
                            android:tint="#94A3B8"
                            tools:ignore="UseAppTint" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- Username Badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="6dp"
                                android:src="@drawable/ic_shield"
                                android:tint="#06B6D4"
                                tools:ignore="UseAppTint" />

                            <TextView
                                android:id="@+id/tvUsername"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Username"
                                android:textColor="#06B6D4"
                                android:textSize="12sp"
                                tools:text="JohnDoe" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Selection Mode Container -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- Mode: Select (Initial View) -->
                        <LinearLayout
                            android:id="@+id/layoutModeSelect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <!-- Title -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Select Session Type"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="32dp"
                                android:text="Create a new secure session or join an existing one"
                                android:textAlignment="center"
                                android:textColor="#94A3B8"
                                android:textSize="13sp" />

                            <!-- Create Session Card -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardCreateSession"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                app:cardBackgroundColor="#1A06B6D4"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#4D06B6D4"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:padding="20dp">

                                    <!-- Icon Container -->
                                    <FrameLayout
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        android:layout_marginEnd="16dp"
                                        android:background="@drawable/bg_icon_container_cyan">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_plus"
                                            android:tint="#06B6D4"
                                            tools:ignore="UseAppTint" />
                                    </FrameLayout>

                                    <!-- Text Content -->
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="4dp"
                                            android:fontFamily="sans-serif-medium"
                                            android:text="Create Session"
                                            android:textColor="#FFFFFF"
                                            android:textSize="16sp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Start a new encrypted chat session and share the session ID"
                                            android:textColor="#94A3B8"
                                            android:textSize="12sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Join Session Card -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardJoinSession"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                app:cardBackgroundColor="#1A10B981"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#4D10B981"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:padding="20dp">

                                    <!-- Icon Container -->
                                    <FrameLayout
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        android:layout_marginEnd="16dp"
                                        android:background="@drawable/bg_icon_container_emerald">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_login"
                                            android:tint="#10B981"
                                            tools:ignore="UseAppTint" />
                                    </FrameLayout>

                                    <!-- Text Content -->
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="4dp"
                                            android:fontFamily="sans-serif-medium"
                                            android:text="Join Session"
                                            android:textColor="#FFFFFF"
                                            android:textSize="16sp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Enter a session ID to join an existing encrypted chat"
                                            android:textColor="#94A3B8"
                                            android:textSize="12sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <!-- Mode: Create Session -->
                        <LinearLayout
                            android:id="@+id/layoutModeCreate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <!-- Icon -->
                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/bg_icon_container_cyan">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_plus"
                                    android:tint="#06B6D4"
                                    tools:ignore="UseAppTint" />
                            </FrameLayout>

                            <!-- Title -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Create New Session"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="24dp"
                                android:text="A unique session ID will be generated for you"
                                android:textAlignment="center"
                                android:textColor="#94A3B8"
                                android:textSize="13sp" />

                            <!-- Info Card -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="24dp"
                                app:cardBackgroundColor="#33334155"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#4D06B6D4"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:padding="16dp">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginEnd="12dp"
                                        android:src="@drawable/ic_key"
                                        android:tint="#06B6D4"
                                        tools:ignore="UseAppTint" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Session will be secured with end-to-end encryption"
                                        android:textColor="#CBD5E1"
                                        android:textSize="13sp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Create Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCreateSession"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Generate &amp; Create Session"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                app:cornerRadius="12dp"
                                app:elevation="8dp" />
                        </LinearLayout>

                        <!-- Mode: Join Session -->
                        <LinearLayout
                            android:id="@+id/layoutModeJoin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <!-- Icon -->
                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/bg_icon_container_emerald">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_login"
                                    android:tint="#10B981"
                                    tools:ignore="UseAppTint" />
                            </FrameLayout>

                            <!-- Title -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Join Session"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="24dp"
                                android:text="Enter the session ID shared with you"
                                android:textAlignment="center"
                                android:textColor="#94A3B8"
                                android:textSize="13sp" />

                            <!-- Session ID Label -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Session ID"
                                android:textColor="#CBD5E1"
                                android:textSize="14sp" />

                            <!-- Session ID Input -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="24dp"
                                app:boxBackgroundColor="#80334155"
                                app:boxBackgroundMode="filled"
                                app:boxCornerRadiusBottomEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxStrokeColor="#4D10B981"
                                app:boxStrokeWidth="1dp"
                                app:hintEnabled="false">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etSessionId"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp"
                                    android:gravity="center"
                                    android:hint="XXXXXXXX"
                                    android:inputType="textCapCharacters"
                                    android:letterSpacing="0.2"
                                    android:textColor="#FFFFFF"
                                    android:textColorHint="#64748B"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Join Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnJoinSession"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"

                                android:fontFamily="sans-serif-medium"
                                android:text="Join Encrypted Session"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                app:cornerRadius="12dp"
                                app:elevation="8dp" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
